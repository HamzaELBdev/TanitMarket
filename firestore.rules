rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // The one account that is always an admin, independent of any Firestore
    // field — avoids a bootstrap problem where nobody can grant the first
    // admin. request.auth.token.email comes from the verified Auth token,
    // so it cannot be spoofed by the client.
    function isPrimaryAdmin() {
      return isSignedIn() && request.auth.token.email == 'hamza.elborjeni@gmail.com';
    }

    function isAdmin() {
      return isPrimaryAdmin() || (
        isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true
      );
    }

    // Which statuses the OWNER of a listing may move it between. Everything
    // else — in particular reaching 'approved' from 'pending' or 'rejected' —
    // is a moderation decision and belongs to an admin (or to the Cloud
    // Functions, which bypass these rules).
    //
    // Before this, the owner rule only locked isHeroFeatured and isSponsored,
    // so an owner could write `status: 'approved'` on a listing the AI or an
    // admin had just rejected, and the "edit sends it back to moderation"
    // behaviour in listingsService was a client-side courtesy, not a
    // guarantee.
    //
    //   anything -> pending                  editing (content changed)
    //   approved/reserved -> reserved/sold   a deal, or marking it sold
    //   reserved/sold/expired -> approved    putting it back online
    //
    // 'expired' is only ever written by the scheduled function, and
    // approved/reserved/sold/expired can only be reached from approved, so the
    // last row cannot be used to approve something that was never approved.
    // Legacy French values are accepted on the "before" side only.
    function ownerMayChangeAdStatus() {
      let before = resource.data.get('status', 'pending');
      let after = request.resource.data.get('status', 'pending');
      return after == before
        || after == 'pending'
        || (after in ['reserved', 'sold'] && before in ['approved', 'Approuvée', 'reserved', 'Réservée'])
        || (after == 'approved' && before in ['reserved', 'Réservée', 'sold', 'expired']);
    }

    // `isPhoneVerified: true` is only accepted for the number actually linked
    // to the caller's Firebase Auth account — Auth sets the ID token's
    // phone_number claim only after the SMS code was confirmed, so a client
    // can't mark an arbitrary number as verified by writing the field itself.
    function phoneClaimMatches(data) {
      return data.get('isPhoneVerified', false) != true || (
        request.auth.token.get('phone_number', null) != null &&
        data.get('phoneNumber', '') == request.auth.token.phone_number
      );
    }

    // emailVerified / verifiedEmail are written by the verifyEmailCode Cloud
    // Function (Admin SDK, bypasses these rules). A client may only create a
    // profile with emailVerified: true when Firebase Auth itself vouches for
    // the sign-in e-mail (e.g. Google), and may never set verifiedEmail.
    function emailClaimOk(data) {
      return !data.keys().hasAny(['verifiedEmail']) && (
        data.get('emailVerified', false) != true ||
        request.auth.token.get('email_verified', false) == true
      );
    }

    // User profiles — anyone can read (public seller info). A user can create
    // and edit their own profile, but never grant themselves role/isAdmin/
    // status — only an existing admin can change those, on any account.
    // Phone fields are re-checked (phoneClaimMatches) only when a write
    // touches them, so profiles saved before this rule stay editable.
    match /users/{userId} {
      allow read: if true;

      allow create: if isSignedIn() && request.auth.uid == userId &&
        request.resource.data.get('isAdmin', false) != true &&
        request.resource.data.get('role', 'Particulier') != 'Admin' &&
        phoneClaimMatches(request.resource.data) &&
        emailClaimOk(request.resource.data);

      allow update: if isAdmin() || (
        isSignedIn() && request.auth.uid == userId &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'isAdmin', 'status', 'emailVerified', 'verifiedEmail']) && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['isPhoneVerified', 'phoneNumber']) ||
          phoneClaimMatches(request.resource.data)
        )
      );

      allow delete: if isAdmin();
    }

    // Marketplace listings — public read, sellers create their own listing
    // (and it always starts 'pending', so a client can't self-approve by
    // calling the SDK directly). An admin may additionally create a listing
    // under any sellerId/status — needed to publish on behalf of a
    // third-party seller (their own phone/contact info, not the admin's
    // account) and to optionally approve it immediately.
    // Only the owner or an admin can update/delete it (approve/reject/edit),
    // but the owner may never flip the admin-only promotional flags
    // (isHeroFeatured, isSponsored) on their own listing — only an admin can.
    match /ads/{adId} {
      allow read: if true;
      allow create: if isAdmin() || (
        isSignedIn() &&
        request.resource.data.sellerId == request.auth.uid &&
        request.resource.data.status == 'pending'
      );
      // Split from `delete` below: request.resource (the would-be resulting
      // document) isn't defined for a delete, so a field-lock check that
      // reads it would break deleting your own listing entirely.
      allow update: if isAdmin() || (
        isSignedIn() && resource.data.sellerId == request.auth.uid &&
        request.resource.data.get('isHeroFeatured', false) == resource.data.get('isHeroFeatured', false) &&
        request.resource.data.get('isSponsored', false) == resource.data.get('isSponsored', false) &&
        ownerMayChangeAdStatus()
      );
      allow delete: if isAdmin() ||
        (isSignedIn() && resource.data.sellerId == request.auth.uid);
    }

    // A member reporting a listing. Anyone signed in may file one report per
    // listing; only admins may read them (the reporter's identity must not be
    // visible to the seller), and nobody but an admin may change or remove
    // one. The id is `<listingId>_<uid>`, so a second report from the same
    // member targets the same document — which is an update, which is denied:
    // that is what stops one account from flooding the admins.
    match /reports/{reportId} {
      allow create: if isSignedIn()
        && request.resource.data.keys().hasOnly(['listingId', 'listingTitle', 'sellerId', 'reporterId', 'reporterName', 'reason', 'details', 'status', 'createdAt'])
        && request.resource.data.listingId is string
        && reportId == request.resource.data.listingId + '_' + request.auth.uid
        && request.resource.data.reporterId == request.auth.uid
        && request.resource.data.reason in ['scam', 'prohibited', 'wrong_category', 'duplicate', 'sold_already', 'other']
        && request.resource.data.status == 'open'
        && request.resource.data.details is string
        && request.resource.data.details.size() <= 500
        && request.resource.data.createdAt == request.time
        && exists(/databases/$(database)/documents/ads/$(request.resource.data.listingId))
        && get(/databases/$(database)/documents/ads/$(request.resource.data.listingId)).data.get('sellerId', '') != request.auth.uid;
      allow read, update, delete: if isAdmin();
    }

    // Buyer/seller chat threads — only the two participants can read/write,
    // and only as themselves. `getOrCreateConversation` does a `getDoc` to
    // check whether the thread already exists before creating it — for a
    // brand-new conversation `resource` is null, so the participants check
    // below can't run; this separate rule lets that existence check through
    // (nothing to leak on a document that isn't there) while still requiring
    // participant membership for real reads/updates once the doc exists.
    match /conversations/{conversationId} {
      allow get: if isSignedIn() && !exists(/databases/$(database)/documents/conversations/$(conversationId));
      allow read, update: if isSignedIn() && request.auth.uid in resource.data.participants;
      allow create: if isSignedIn() && request.auth.uid in request.resource.data.participants;

      match /messages/{messageId} {
        allow read: if isSignedIn() &&
          request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants;
        allow create: if isSignedIn() &&
          request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants &&
          request.resource.data.senderId == request.auth.uid;
      }
    }

    // Seller reviews — public read; a signed-in user may create/update only
    // their own review (one per seller, keyed by `${sellerId}__${authorId}`),
    // and never review themselves.
    match /sellerReviews/{reviewId} {
      allow read: if true;
      allow create, update: if isSignedIn() &&
        request.resource.data.authorId == request.auth.uid &&
        request.resource.data.sellerId != request.auth.uid &&
        reviewId == request.resource.data.sellerId + '__' + request.auth.uid;
    }

    // Notifications — a user reads/marks-read only their own; an admin reads
    // all (including the shared 'admin' feed); any signed-in user may create
    // one (e.g. notifying the seller or the admin feed).
    match /notifications/{notifId} {
      allow read, update: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn();
    }

    // Per-listing counters for the admin dashboard. Anyone may add exactly one
    // view at a time; `messages` is only ever written by Cloud Functions.
    match /adStats/{adId} {
      allow read: if isAdmin();
      allow create: if request.resource.data.keys().hasOnly(['views']) &&
        request.resource.data.views == 1;
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['views']) &&
        request.resource.data.views == resource.data.get('views', 0) + 1;
    }

    // E-mail delivery log — written by Cloud Functions (Admin SDK), admins read.
    match /emailLogs/{logId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Deny anything not explicitly covered above.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
