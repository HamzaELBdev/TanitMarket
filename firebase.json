{
  "firestore": {
    "rules": "firestore.rules"
  },
  "storage": {
    "target": "default",
    "rules": "storage.rules"
  },
  "hosting": {
    "public": "out",
    "cleanUrls": true,
    "trailingSlash": false,
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/product/**",
        "function": "productSocialPreview"
      },
      {
        "source": "/seller/**",
        "destination": "/seller/_shell.html"
      }
    ]
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "runtime": "nodejs22"
    }
  ]
}
